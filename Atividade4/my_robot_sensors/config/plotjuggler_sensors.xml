<?xml version='1.0' encoding='UTF-8'?>
<root>
    <tabbed_widget name="Main Window" parent="main_window">
        <Tab tab_name="IMU" containers="1">
            <Container>
                <DockSplitter orientation="-" count="2" sizes="0.5;0.5">
                    <DockArea name="Velocidade Angular (rad/s)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-2.000000" top="2.000000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/imu/data/angular_velocity/x" color="#1f77b4"/>
                            <curve name="/imu/data/angular_velocity/y" color="#2ca02c"/>
                            <curve name="/imu/data/angular_velocity/z" color="#d62728"/>
                        </plot>
                    </DockArea>
                    <DockArea name="Aceleracao Linear (m/s^2)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-15.000000" top="15.000000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/imu/data/linear_acceleration/x" color="#1f77b4"/>
                            <curve name="/imu/data/linear_acceleration/y" color="#2ca02c"/>
                            <curve name="/imu/data/linear_acceleration/z" color="#d62728"/>
                        </plot>
                    </DockArea>
                </DockSplitter>
            </Container>
        </Tab>
        <Tab tab_name="GPS" containers="1">
            <Container>
                <DockSplitter orientation="|" count="2" sizes="0.5;0.5">
                    <DockArea name="GPS Convertido - Plano XY (m)">
                        <plot flip_y="false" mode="XYPlot" flip_x="false" style="Lines">
                            <range bottom="-5.000000" top="5.000000" left="-5.000000" right="5.000000"/>
                            <limitY/>
                            <curve name="/gps/pose/pose/position/[x;y]" color="#d62728" curve_x="/gps/pose/pose/position/x" curve_y="/gps/pose/pose/position/y"/>
                            <curve name="/odom/pose/pose/position/[x;y]" color="#1f77b4" curve_x="/odom/pose/pose/position/x" curve_y="/odom/pose/pose/position/y"/>
                        </plot>
                    </DockArea>
                    <DockSplitter orientation="-" count="2" sizes="0.5;0.5">
                        <DockArea name="Posicoes X e Y no Tempo (m)">
                            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                                <range bottom="-5.000000" top="5.000000" left="0.000000" right="60.000000"/>
                                <limitY/>
                                <curve name="/gps/pose/pose/position/x" color="#d62728"/>
                                <curve name="/gps/pose/pose/position/y" color="#2ca02c"/>
                                <curve name="/odom/pose/pose/position/x" color="#1f77b4"/>
                                <curve name="/odom/pose/pose/position/y" color="#ff7f0e"/>
                            </plot>
                        </DockArea>
                        <DockArea name="GPS Bruto (Latitude / Longitude)">
                            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                                <range bottom="-90.000000" top="90.000000" left="0.000000" right="60.000000"/>
                                <limitY/>
                                <curve name="/gps/fix/latitude" color="#9467bd"/>
                                <curve name="/gps/fix/longitude" color="#8c564b"/>
                            </plot>
                        </DockArea>
                    </DockSplitter>
                </DockSplitter>
            </Container>
        </Tab>
    </tabbed_widget>
    <loaded_associations/>
</root>
