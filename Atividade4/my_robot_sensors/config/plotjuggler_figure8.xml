<?xml version='1.0' encoding='UTF-8'?>
<!--
  Pratica 04 - Exercicio 2.1
  Layout do PlotJuggler para a trajetoria em 8 com sensores e ruído.

  Aba "Trajetoria" - esquerda  - plano XY, 8 desejado (azul) x sensor (verde) x real/odom (vermelho)
                     direita   - x(t) e y(t), desejado x sensor x real
  Aba "Controle (cmd_vel)" - velocidade linear v e angular w (efeito do ruido nos comandos)
  Aba "Erro"       - erro de posicao em x e y, erro de orientacao e RMSE
-->
<root>
    <tabbed_widget name="Main Window" parent="main_window">
        <Tab tab_name="Trajetoria" containers="1">
            <Container>
                <DockSplitter orientation="|" count="2" sizes="0.55;0.45">
                    <DockArea name="Plano XY (m)">
                        <plot flip_y="false" mode="XYPlot" flip_x="false" style="Lines">
                            <range bottom="-1.500000" top="1.500000" left="-1.500000" right="1.500000"/>
                            <limitY/>
                            <curve name="/figure8/desired_pose/pose/position/[x;y]" color="#1f77b4" curve_x="/figure8/desired_pose/pose/position/x" curve_y="/figure8/desired_pose/pose/position/y"/>
                            <curve name="/figure8/sensor_pose/pose/position/[x;y]" color="#2ca02c" curve_x="/figure8/sensor_pose/pose/position/x" curve_y="/figure8/sensor_pose/pose/position/y"/>
                            <curve name="/odom/pose/pose/position/[x;y]" color="#d62728" curve_x="/odom/pose/pose/position/x" curve_y="/odom/pose/pose/position/y"/>
                        </plot>
                    </DockArea>
                    <DockSplitter orientation="-" count="2" sizes="0.5;0.5">
                        <DockArea name="x (m)">
                            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                                <range bottom="-1.200000" top="1.200000" left="0.000000" right="60.000000"/>
                                <limitY/>
                                <curve name="/figure8/desired_pose/pose/position/x" color="#1f77b4"/>
                                <curve name="/figure8/sensor_pose/pose/position/x" color="#2ca02c"/>
                                <curve name="/odom/pose/pose/position/x" color="#d62728"/>
                            </plot>
                        </DockArea>
                        <DockArea name="y (m)">
                            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                                <range bottom="-1.200000" top="1.200000" left="0.000000" right="60.000000"/>
                                <limitY/>
                                <curve name="/figure8/desired_pose/pose/position/y" color="#1f77b4"/>
                                <curve name="/figure8/sensor_pose/pose/position/y" color="#2ca02c"/>
                                <curve name="/odom/pose/pose/position/y" color="#d62728"/>
                            </plot>
                        </DockArea>
                    </DockSplitter>
                </DockSplitter>
            </Container>
        </Tab>
        <Tab tab_name="Controle (cmd_vel)" containers="1">
            <Container>
                <DockSplitter orientation="-" count="2" sizes="0.5;0.5">
                    <DockArea name="Velocidade Linear v (m/s)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-0.200000" top="2.000000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/cmd_vel/linear/x" color="#1f77b4"/>
                        </plot>
                    </DockArea>
                    <DockArea name="Velocidade Angular w (rad/s)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-4.000000" top="4.000000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/cmd_vel/angular/z" color="#d62728"/>
                        </plot>
                    </DockArea>
                </DockSplitter>
            </Container>
        </Tab>
        <Tab tab_name="Erro" containers="1">
            <Container>
                <DockSplitter orientation="-" count="3" sizes="0.333;0.333;0.334">
                    <DockArea name="Erro de posicao (m)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-0.500000" top="0.500000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/figure8/error/vector/x" color="#1f77b4"/>
                            <curve name="/figure8/error/vector/y" color="#2ca02c"/>
                            <curve name="/figure8/real_error/vector/x" color="#ff7f0e"/>
                            <curve name="/figure8/real_error/vector/y" color="#d62728"/>
                        </plot>
                    </DockArea>
                    <DockArea name="Erro de orientacao (rad)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-1.000000" top="1.000000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/figure8/error/vector/z" color="#9467bd"/>
                            <curve name="/figure8/real_error/vector/z" color="#8c564b"/>
                        </plot>
                    </DockArea>
                    <DockArea name="RMSE acumulado">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="0.000000" top="0.500000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/figure8/rmse/vector/x" color="#d62728"/>
                            <curve name="/figure8/rmse/vector/y" color="#ff7f0e"/>
                        </plot>
                    </DockArea>
                </DockSplitter>
            </Container>
        </Tab>
        <currentTabIndex index="0"/>
    </tabbed_widget>
    <use_relative_time_offset enabled="1"/>
    <!-- ................. -->
    <Plugins>
        <plugin ID="ROS2 Topic Subscriber">
            <use_header_stamp value="false"/>
            <discard_large_arrays value="true"/>
            <max_array_size value="100"/>
            <selected_topics value="/odom;/cmd_vel;/figure8/desired_pose;/figure8/sensor_pose;/figure8/error;/figure8/real_error;/figure8/rmse"/>
        </plugin>
    </Plugins>
    <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
    <!-- ................. -->
    <customMathEquations/>
    <snippets/>
</root>
