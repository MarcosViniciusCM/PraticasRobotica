<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>my_robot_trajectory</name>
  <version>0.1.0</version>
  <description>Pratica 03 - Controle de trajetoria: controle de pose (continuo e tres manobras), seguimento de missao por waypoints e seguimento de trajetoria em 8</description>
  <maintainer email="marcosviniciuscm16@gmail.com">marco</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>control_toolbox</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>my_robot_control</exec_depend>
  <exec_depend>plotjuggler_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
