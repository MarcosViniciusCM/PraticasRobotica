<?xml version='1.0' encoding='UTF-8'?>
<!--
  Pratica 05.1 - Exercicio 2.1
  Layout do PlotJuggler - os quatro sinais pedidos no roteiro
    preto tracejado  trajetoria desejada  /figure8/desired_pose
    verde            estado real          /ground_truth/odom   (Gazebo)
    vermelho/laranja estado bruto         /odom/noisy (odometria) e /sensor/pose (posicao)
    azul             estado estimado      /odometry/filtered   (filtro de Kalman)
-->
<root>
    <tabbed_widget name="Main Window" parent="main_window">
        <Tab tab_name="Trajetoria" containers="1">
            <Container>
                <DockSplitter orientation="|" count="2" sizes="0.55;0.45">
                    <DockArea name="Plano XY (m)">
                        <plot flip_y="false" mode="XYPlot" flip_x="false" style="Lines">
                            <range bottom="-1.500000" top="1.500000" left="-1.500000" right="1.500000"/>
                            <limitY/>
                            <curve name="/figure8/desired_pose/pose/position/[x;y]" color="#000000" curve_x="/figure8/desired_pose/pose/position/x" curve_y="/figure8/desired_pose/pose/position/y"/>
                            <curve name="/ground_truth/odom/pose/pose/position/[x;y]" color="#2ca02c" curve_x="/ground_truth/odom/pose/pose/position/x" curve_y="/ground_truth/odom/pose/pose/position/y"/>
                            <curve name="/odom/noisy/pose/pose/position/[x;y]" color="#d62728" curve_x="/odom/noisy/pose/pose/position/x" curve_y="/odom/noisy/pose/pose/position/y"/>
                            <curve name="/sensor/pose/pose/pose/position/[x;y]" color="#ff7f0e" curve_x="/sensor/pose/pose/pose/position/x" curve_y="/sensor/pose/pose/pose/position/y"/>
                            <curve name="/odometry/filtered/pose/pose/position/[x;y]" color="#1f77b4" curve_x="/odometry/filtered/pose/pose/position/x" curve_y="/odometry/filtered/pose/pose/position/y"/>
                        </plot>
                    </DockArea>
                    <DockSplitter orientation="-" count="2" sizes="0.5;0.5">
                        <DockArea name="x (m)">
                            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                                <range bottom="-1.500000" top="1.500000" left="0.000000" right="60.000000"/>
                                <limitY/>
                                <curve name="/figure8/desired_pose/pose/position/x" color="#000000"/>
                                <curve name="/ground_truth/odom/pose/pose/position/x" color="#2ca02c"/>
                                <curve name="/odom/noisy/pose/pose/position/x" color="#d62728"/>
                                <curve name="/sensor/pose/pose/pose/position/x" color="#ff7f0e"/>
                                <curve name="/odometry/filtered/pose/pose/position/x" color="#1f77b4"/>
                            </plot>
                        </DockArea>
                        <DockArea name="y (m)">
                            <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                                <range bottom="-1.500000" top="1.500000" left="0.000000" right="60.000000"/>
                                <limitY/>
                                <curve name="/figure8/desired_pose/pose/position/y" color="#000000"/>
                                <curve name="/ground_truth/odom/pose/pose/position/y" color="#2ca02c"/>
                                <curve name="/odom/noisy/pose/pose/position/y" color="#d62728"/>
                                <curve name="/sensor/pose/pose/pose/position/y" color="#ff7f0e"/>
                                <curve name="/odometry/filtered/pose/pose/position/y" color="#1f77b4"/>
                            </plot>
                        </DockArea>
                    </DockSplitter>
                </DockSplitter>
            </Container>
        </Tab>
        <Tab tab_name="Erro" containers="1">
            <Container>
                <DockSplitter orientation="-" count="2" sizes="0.5;0.5">
                    <DockArea name="Erro de seguimento - real x desejada (m)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="-0.500000" top="0.500000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/figure8/error/vector/x" color="#1f77b4"/>
                            <curve name="/figure8/error/vector/y" color="#2ca02c"/>
                        </plot>
                    </DockArea>
                    <DockArea name="RMSE acumulado (controle com o estado usado)">
                        <plot flip_y="false" mode="TimeSeries" flip_x="false" style="Lines">
                            <range bottom="0.000000" top="0.500000" left="0.000000" right="60.000000"/>
                            <limitY/>
                            <curve name="/figure8/rmse/vector/x" color="#d62728"/>
                        </plot>
                    </DockArea>
                </DockSplitter>
            </Container>
        </Tab>
        <currentTabIndex index="0"/>
    </tabbed_widget>
    <use_relative_time_offset enabled="1"/>
    <Plugins>
        <plugin ID="ROS2 Topic Subscriber">
            <use_header_stamp value="false"/>
            <discard_large_arrays value="true"/>
            <max_array_size value="100"/>
            <selected_topics value="/ground_truth/odom;/odom/noisy;/sensor/pose;/odometry/filtered;/figure8/desired_pose;/figure8/error;/figure8/rmse"/>
        </plugin>
    </Plugins>
    <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
    <customMathEquations/>
    <snippets/>
</root>
