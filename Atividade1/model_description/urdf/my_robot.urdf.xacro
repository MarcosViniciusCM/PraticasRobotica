<?xml version="1.0"?>
<!--
  Robô diferencial modelado seguindo os tutoriais do Gazebo Classic:
  - Build a Robot: https://classic.gazebosim.org/tutorials?tut=build_robot&cat=build_robot
  - Attach Meshes: https://classic.gazebosim.org/tutorials?tut=attach_meshes
-->
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="chassis_x" value="0.4" />
  <xacro:property name="chassis_y" value="0.2" />
  <xacro:property name="chassis_z" value="0.1" />
  <xacro:property name="wheel_radius" value="0.1" />
  <xacro:property name="wheel_length" value="0.05" />
  <xacro:property name="wheel_offset_x" value="0.1" />
  <xacro:property name="wheel_offset_y" value="0.13" />
  <xacro:property name="caster_radius" value="0.05" />
  <xacro:property name="half_pi" value="1.5707963267948966" />

  <!-- ==================== chassis ==================== -->
  <link name="base_link">
    <visual>
      <!-- mesh unitario escalado para as dimensoes do chassi (tutorial Attach Meshes) -->
      <geometry>
        <mesh filename="package://model_description/meshes/chassis_box.stl"
              scale="${chassis_x} ${chassis_y} ${chassis_z}" />
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.3 0.8 1.0" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="5.0" />
      <inertia ixx="0.0216" ixy="0.0" ixz="0.0" iyy="0.0729" iyz="0.0" izz="0.0879" />
    </inertial>
  </link>

  <!-- ==================== rodas ==================== -->
  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${half_pi} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${half_pi} 0 0" />
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5" />
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001" />
      </inertial>
    </link>

    <joint name="${prefix}_wheel_hinge" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel" />
      <origin xyz="${wheel_offset_x} ${reflect * wheel_offset_y} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>

    <gazebo reference="${prefix}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel prefix="left" reflect="1" />
  <xacro:wheel prefix="right" reflect="-1" />

  <!-- ==================== caster (esfera sem atrito) ==================== -->
  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
      <material name="black" />
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
  </link>

  <joint name="caster_wheel_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster_wheel" />
    <origin xyz="-0.15 0 -0.05" rpy="0 0 0" />
  </joint>

  <gazebo reference="caster_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ==================== plugin de tracao diferencial ==================== -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <left_joint>left_wheel_hinge</left_joint>
      <right_joint>right_wheel_hinge</right_joint>
      <wheel_separation>${2 * wheel_offset_y}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

</robot>
